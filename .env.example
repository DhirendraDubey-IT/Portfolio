# Dhirendra Dubey 3D Portfolio Environment Configuration
PORT=3000

# MONGODB_URI: Required for MongoDB persistent database storage.
# If omitted during local testing, an in-memory fallback store is used.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/dhirendra_portfolio?retryWrites=true&w=majority

# CLIENT_URL: Optional during development / AI Studio preview.
# If left empty, the preview / development origin is automatically permitted.
# When deploying to production, specify your live domain (e.g., https://your-portfolio-domain.com).
CLIENT_URL=

# AI Studio Runtime Variables
GEMINI_API_KEY=""
APP_URL=""
